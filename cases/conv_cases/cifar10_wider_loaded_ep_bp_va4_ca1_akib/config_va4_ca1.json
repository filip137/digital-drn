{
  "algorithm": {
    "name": "ep",
    "config": {
      "enabled": true,
      "beta": 0.01,
      "nudging_mode": "current",
      "ad_hoc_amp_gradient_scale": false
    }
  },
  "trainer": {
    "epochs": 200,
    "criterion": "cross_entropy",
    "optimizer": {
      "name": "adam",
      "lr": 0.0001,
      "config": {
        "weight_decay": 0.0003
      }
    },
    "scheduler": {
      "name": "cosine",
      "config": {
        "T_max": "epochs",
        "eta_min": 1e-05
      }
    },
    "grad_clip_norm": null,
    "log_every": 50,
    "eval_every": 1,
    "save_every": 0,
    "save_best": true,
    "save_last": false,
    "save_events": true
  },
  "data": {
    "name": "cifar10",
    "config": {
      "input_dim": 3072,
      "input_shape": [
        3,
        32,
        32
      ],
      "output_size": 10,
      "batch_size": 16,
      "num_workers": 0,
      "data_root": "~/data",
      "train_subset": null,
      "test_subset": null
    }
  },
  "model": {
    "name": "cifar10_drn_only_signed_norm_readout_wider",
    "config": {
      "input_dim": 3072,
      "input_shape": [
        3,
        32,
        32
      ],
      "num_classes": 10,
      "ff_activation": "identity",
      "ff_bias": false,
      "drn_non_linearity": "perfect_diode",
      "mode": "asynchronous",
      "voltage_amp": 4.0,
      "current_amp": 1.0,
      "weight_init_mode": "kaiming_uniform",
      "learn_drive_scale": true,
      "init_drive_scale": 1.0,
      "quadratic_diode_param": {},
      "exponential_diode_param": {},
      "hard_sigmoid_param": {}
    },
    "blocks_config": [
      {
        "ff": {
          "type": "digital_conv_block",
          "lr": 0.001,
          "signed_drive": true,
          "layers": [
            {
              "op": "batchnorm2d",
              "num_features": 3
            }
          ],
          "output_shape": [
            3,
            32,
            32
          ]
        },
        "drn": {
          "type": "conv_drn_block",
          "lr": 0.0001,
          "num_layers": 3,
          "state_shape": [
            6,
            32,
            32
          ],
          "channels": [
            6,
            32,
            64
          ],
          "kernel_size": 3,
          "stride": 1,
          "padding": 1,
          "use_batchnorm": false,
          "use_pooling": false,
          "preserve_resolution": true,
          "weight_gains": [
            1.0,
            1.0
          ],
          "bias_gain": 0.0,
          "weight_min": 1e-07,
          "weight_max": 10.0,
          "num_iterations": 6,
          "voltage_amp": 4.0,
          "current_amp": 1.0
        }
      },
      {
        "ff": {
          "type": "digital_transition_block",
          "lr": 0.001,
          "signed_drive": true,
          "transition_option": "A",
          "layers": [
            {
              "op": "batchnorm2d",
              "num_features": 64
            },
            {
              "op": "maxpool2d",
              "kernel_size": 2,
              "stride": 2
            }
          ],
          "output_shape": [
            64,
            16,
            16
          ]
        },
        "drn": {
          "type": "conv_drn_block",
          "lr": 0.0001,
          "num_layers": 3,
          "state_shape": [
            128,
            16,
            16
          ],
          "channels": [
            128,
            256,
            512
          ],
          "kernel_size": 3,
          "stride": 1,
          "padding": 1,
          "use_batchnorm": false,
          "use_pooling": false,
          "preserve_resolution": true,
          "weight_gains": [
            1.0,
            1.0
          ],
          "bias_gain": 0.0,
          "weight_min": 1e-07,
          "weight_max": 10.0,
          "num_iterations": 6,
          "voltage_amp": 4.0,
          "current_amp": 1.0
        }
      }
    ],
    "head": {
      "type": "digital_classifier_head",
      "lr": 0.0003,
      "layers": [
        {
          "op": "maxpool2d",
          "kernel_size": 2,
          "stride": 2
        },
        {
          "op": "flatten"
        },
        {
          "op": "linear",
          "in_features": 32768,
          "out_features": 256
        },
        {
          "op": "tanh"
        },
        {
          "op": "linear",
          "in_features": 256,
          "out_features": 10
        }
      ]
    }
  },
  "_selection": {
    "algorithm": "ep",
    "trainer": "default",
    "data": "cifar10",
    "model": "cifar10_drn_only_signed_norm_readout"
  },
  "exp_type": "training",
  "config": {
    "device": "cuda",
    "save": true,
    "seed": 0,
    "deterministic": false,
    "logger": null,
    "project_name": "digital_drn",
    "output_dir": "simulation_results"
  }
}